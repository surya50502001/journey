# Builder Journey Intelligence Platform - Environment Configuration

# Database Options: "PostgreSql" or "Sqlite"
DatabaseProvider=Sqlite

# PostgreSQL Connection String (used if DatabaseProvider=PostgreSql)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=builderjourney;Username=postgres;Password=your_secure_password

# JWT Security
Jwt__Secret=YourSuperSecretKeyThatIsAtLeast32BytesLongForHmacSha256!
Jwt__Issuer=BuilderJourneyPlatform
Jwt__Audience=BuilderJourneyPlatformAudience
Jwt__ExpiryHours=48

# Sensitive Token AES-256 Encryption
Security__EncryptionKey=YourSecureAES256KeyForSensitiveTokenEncryption!

# Official X (Twitter) API v2 Integration
X__BearerToken=your_x_api_bearer_token_here
